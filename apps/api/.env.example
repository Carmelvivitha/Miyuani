# Database Configuration
DATABASE_URL=postgresql+asyncpg://miyuani_user:miyuani_pass@localhost:5432/miyuani_db

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Application Settings
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3000

# Google Earth Engine Configuration
# Get credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON key and place in apps/api/credentials/
EARTH_ENGINE_SERVICE_ACCOUNT_KEY=./credentials/earth-engine-service-account.json
